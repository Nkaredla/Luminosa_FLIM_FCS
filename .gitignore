# Platform-specific MEX build artefacts - rebuild with mex -O <name>.c
*.mexw64
*.mexa64
*.mexmaci64

# MATLAB -batch console output. These are run transcripts, not source: they are
# regenerated on every run and were being committed by accident.
# The vendored miet-gui tree keeps its own missfont.log, which predates this and
# is left tracked.
*.log
!external/miet-gui/Documentation/missfont.log
